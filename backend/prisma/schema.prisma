datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Student {
  id               String          @id @default(uuid())
  jntuNo           String          @unique
  passwordHash     String
  name             String
  email            String          @unique
  role             String          @default("STUDENT")
  allocationStatus String          @default("NOT_ALLOCATED") // ALLOCATED, PENDING, NOT_ALLOCATED
  blockName        String?
  floorName        String?
  roomNumber       String?
  bedNumber        String?
  roomType         String?         // e.g. "Non-AC Room (2 Sharing)"
  roomCapacity     Int             @default(2)
  allocatedAt      DateTime?       @default(now())
  monthlyOutingMax Int             @default(5)
  isActive         Boolean         @default(true)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  sessions         Session[]
  outings          OutingRequest[]
  messTokens       MessToken[]
  leaves           LeaveRequest[]
  suspensions      Suspension[]
  complaints       Complaint[]
  attachments      Attachment[]
  notifications    Notification[]
  activityLogs     ActivityLog[]
  biometricEvents  BiometricEvent[]
  roomAllocations  RoomAllocation[]
  guestVisits      GuestVisit[]
  scholarships     StudentScholarship[]
  detentions       Detention[]
  feeItems         FeeItem[]
  feePayments      FeePayment[]
  feeReceipts      FeeReceipt[]
  feeRefunds       FeeRefund[]

  @@index([role])
  @@index([isActive])
}

model Session {
  id        String   @id @default(uuid())
  token     String   @unique
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model OutingRequest {
  id               String    @id @default(uuid())
  requestNumber    String?   @unique
  studentId        String
  student          Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  passType         String    @default("LOCAL_OUTING") // LOCAL_OUTING, EMERGENCY, NIGHT_OUT
  destination      String?
  purpose          String
  emergencyContact String?
  remarks          String?
  outDate          DateTime
  returnDate       DateTime
  actualExitTime   DateTime?
  actualReturnTime DateTime?
  rejectionReason  String?
  approvedAt       DateTime?
  approvedBy       String?
  rejectedAt       DateTime?
  rejectedBy       String?
  status           String    @default("PENDING") // PENDING, APPROVED, OUT, RETURNED, REJECTED, CANCELLED
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([studentId, createdAt])
  @@index([studentId])
  @@index([status])
}

model MessToken {
  id                 String    @id @default(uuid())
  tokenNumber        String?   @unique
  studentId          String
  student            Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  date               String    // YYYY-MM-DD
  mealType           String    // BREAKFAST, LUNCH, SNACKS, DINNER
  status             String    @default("BOOKED") // DRAFT, BOOKED, SKIPPED, CONSUMED, CANCELLED
  isLocked           Boolean   @default(false)
  lockedAt           DateTime?
  attendanceIntent   String?   // ATTENDING, SKIPPED
  consumedAt         DateTime?
  cancelledAt        DateTime?
  cancellationReason String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @default(now()) @updatedAt

  @@unique([studentId, date, mealType])
  @@index([date])
  @@index([status])
  @@index([mealType])
  @@index([studentId])
  @@index([date, mealType])
  @@index([date, status])
  @@index([isLocked])
}

model LeaveRequest {
  id               String    @id @default(uuid())
  requestNumber    String?   @unique
  studentId        String
  student          Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  leaveType        String    // HOME_LEAVE, MEDICAL, ACADEMIC, EMERGENCY, SPECIAL_LEAVE
  destination      String?
  startDate        DateTime
  endDate          DateTime
  reason           String
  emergencyContact String?
  remarks          String?
  rejectionReason  String?
  approvedAt       DateTime?
  approvedBy       String?
  rejectedAt       DateTime?
  rejectedBy       String?
  status           String    @default("PENDING") // PENDING, APPROVED, REJECTED, CANCELLED
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([studentId, status])
  @@index([studentId])
  @@index([status])
}

model Suspension {
  id          String    @id @default(uuid())
  studentId   String
  student     Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  reason      String
  startDate   DateTime
  endDate     DateTime
  status      String    @default("ACTIVE") // ACTIVE, LIFTED, EXPIRED
  createdBy   String    @default("HOSTEL_ADMIN")
  remarks     String?
  liftedAt    DateTime?
  liftedBy    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([studentId, status])
  @@index([studentId])
  @@index([status])
}


model Notification {
  id          String    @id @default(uuid())
  studentId   String
  student     Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  title       String
  message     String
  type        String    @default("INFO") // INFO, WARNING, SUCCESS
  category    String    @default("SYSTEM") // OUTING, LEAVE, COMPLAINT, MESS, SUSPENSION, ROOM, SYSTEM, ANNOUNCEMENT, BIOMETRIC, FEE, DEVICE
  priority    String    @default("NORMAL") // LOW, NORMAL, HIGH, URGENT
  source      String    @default("SYSTEM") // SYSTEM, ADMIN_PORTAL, AUTOMATED
  createdBy   String?   // Admin username or actor
  isRead      Boolean   @default(false)
  readAt      DateTime?
  entityId    String?
  link        String?
  expiresAt   DateTime?
  metadata    String?
  createdAt   DateTime  @default(now())

  @@index([studentId])
  @@index([category])
  @@index([isRead])
  @@index([priority])
  @@index([source])
  @@index([createdAt])
}

model ActivityLog {
  id            String   @id @default(uuid())
  studentId     String
  student       Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  actionType    String   // OUTING, MESS, LEAVE, ROOM, LOGIN, COMPLAINT (preserved for backward compatibility)
  action        String?  // CREATE, UPDATE, DELETE, ALLOCATE, VACATE, REALLOCATE, APPROVE, REJECT, CANCEL, ASSIGN, START, RESOLVE, CLOSE, CHECKOUT, CONSUME, PAYMENT_RECORDED, VOID, SUSPEND, LIFT_SUSPENSION, LOGIN, LOGOUT, CONFIG_UPDATE
  actorRole     String?  // STUDENT, WARDEN, CHIEF_WARDEN, ADMIN, etc.
  entity        String?  // Block, Room, RoomAllocation, Complaint, OutingRequest, LeaveRequest, Suspension, Guest, GuestVisit, GuestBill, BiometricEvent, Session, MessToken, etc.
  entityId      String?  // ID of the target entity
  previousState String?  // e.g. "PENDING" or JSON snapshot
  newState      String?  // e.g. "APPROVED" or JSON snapshot
  description   String
  metadata      String?  // JSON stringified safe metadata (no sensitive credentials/tokens)
  ipAddress     String?  // Client IP address
  createdAt     DateTime @default(now())

  @@index([createdAt])
  @@index([studentId])
  @@index([actorRole])
  @@index([action])
  @@index([entity])
  @@index([entityId])
}

model Complaint {
  id              String       @id @default(uuid())
  ticketNumber    String?      @unique
  studentId       String
  student         Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  category        String       // ROOM, ELECTRICAL, PLUMBING, CLEANING, FURNITURE, WIFI, MESS, SECURITY, OTHER
  title           String
  description     String
  location        String?
  priority        String       @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  status          String       @default("OPEN") // OPEN, ASSIGNED, IN_PROGRESS, RESOLVED, CLOSED, CANCELLED, REJECTED
  // Management workflow fields
  assignedTo      String?      // Maintenance staff display name
  assignedToId    String?      // Staff member Student.id (MAINTENANCE_STAFF role)
  assignedAt      DateTime?    // Timestamp of assignment
  assignedBy      String?      // Manager name who performed assignment
  resolutionNotes String?
  resolvedBy      String?      // Staff/manager who resolved
  resolvedAt      DateTime?
  closedAt        DateTime?    // Timestamp of closure
  closedBy        String?      // Manager who closed
  comments        String?      // JSON-serialized follow-up comments array
  attachments     Attachment[]
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([status])
  @@index([priority])
  @@index([category])
  @@index([studentId])
  @@index([assignedToId])
}

model Attachment {
  id          String    @id @default(uuid())
  complaintId String
  complaint   Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  studentId   String
  student     Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  fileName    String
  storedName  String
  mimeType    String
  fileSize    Int
  createdAt   DateTime  @default(now())
}

model BiometricEvent {
  id                 String   @id @default(uuid())
  studentId          String
  student            Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  eventType          String   // ENTRY, EXIT
  direction          String   @default("IN") // IN, OUT
  verificationStatus String   @default("VERIFIED") // VERIFIED, REJECTED
  eventTimestamp     DateTime @default(now())
  source             String   @default("BIOMETRIC_DEVICE") // BIOMETRIC_DEVICE, RFID, MANUAL_GATE, SYSTEM
  gate               String?  // Main Gate, Hostel Gate A, Mess Turnstile, North Gate
  deviceId           String?  // DEV-GATE-01, DEV-GATE-02
  deviceLabel        String?  // Turnstile #1 - Main Gate
  rejectionReason    String?  // Fingerprint mismatch, Device timeout, etc.
  metadata           String?  // JSON stringified optional metadata
  createdAt          DateTime @default(now())

  @@index([studentId])
  @@index([eventTimestamp])
  @@index([studentId, eventTimestamp])
  @@index([eventType])
  @@index([verificationStatus])
}

model Block {
  id          String   @id @default(uuid())
  name        String
  code        String   @unique
  description String?
  status      String   @default("ACTIVE") // ACTIVE, INACTIVE
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  rooms       Room[]

  @@index([status])
  @@index([code])
}

model Room {
  id          String           @id @default(uuid())
  blockId     String
  block       Block            @relation(fields: [blockId], references: [id], onDelete: Restrict)
  roomNumber  String
  floor       Int?             @default(1)
  roomType    String?          @default("Non-AC Room (2 Sharing)")
  capacity    Int              @default(2)
  status      String           @default("ACTIVE") // ACTIVE, INACTIVE, UNDER_MAINTENANCE
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  allocations RoomAllocation[]

  @@unique([blockId, roomNumber])
  @@index([blockId])
  @@index([status])
}

model RoomAllocation {
  id          String    @id @default(uuid())
  roomId      String
  room        Room      @relation(fields: [roomId], references: [id], onDelete: Restrict)
  studentId   String
  student     Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  bedNumber   String?   // e.g. "Bed-1", "Bed-2"
  status      String    @default("ACTIVE") // ACTIVE, VACATED, REALLOCATED
  allocatedAt DateTime  @default(now())
  vacatedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([roomId])
  @@index([studentId])
  @@index([status])
}

model Guest {
  id             String       @id @default(uuid())
  name           String
  phone          String
  email          String?
  idProofType    String?      // AADHAAR, PAN, DRIVING_LICENSE, PASSPORT, VOTER_ID, OTHER
  idProofNumber  String?
  address        String?
  relation       String?      // PARENT, GUARDIAN, SIBLING, RELATIVE, FRIEND, OTHER
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  visits         GuestVisit[]

  @@index([phone])
  @@index([name])
}

model GuestVisit {
  id            String      @id @default(uuid())
  guestId       String
  guest         Guest       @relation(fields: [guestId], references: [id], onDelete: Restrict)
  hostStudentId String
  hostStudent   Student     @relation(fields: [hostStudentId], references: [id], onDelete: Restrict)
  purpose       String
  visitDate     DateTime    @default(now())
  checkInTime   DateTime    @default(now())
  checkOutTime  DateTime?
  status        String      @default("CHECKED_IN") // CHECKED_IN, CHECKED_OUT, CANCELLED
  remarks       String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  bills         GuestBill[]

  @@index([guestId])
  @@index([hostStudentId])
  @@index([status])
  @@index([visitDate])
}

model GuestBill {
  id               String         @id @default(uuid())
  guestVisitId     String
  guestVisit       GuestVisit     @relation(fields: [guestVisitId], references: [id], onDelete: Restrict)
  billNumber       String         @unique
  totalAmount      Float
  paidAmount       Float          @default(0)
  balanceAmount    Float          @default(0)
  paymentStatus    String         @default("UNPAID") // UNPAID, PARTIALLY_PAID, PAID, VOID
  paymentMethod    String?        // CASH, UPI, CARD, BANK_TRANSFER, OTHER
  paymentReference String?
  paidAt           DateTime?
  voidReason       String?
  voidedAt         DateTime?
  voidedBy         String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  items            BillingItem[]
  payments         GuestPayment[]

  @@index([guestVisitId])
  @@index([paymentStatus])
  @@index([billNumber])
}

model BillingItem {
  id          String    @id @default(uuid())
  guestBillId String
  guestBill   GuestBill @relation(fields: [guestBillId], references: [id], onDelete: Cascade)
  description String
  quantity    Int       @default(1)
  unitAmount  Float
  totalAmount Float
  createdAt   DateTime  @default(now())

  @@index([guestBillId])
}

model GuestPayment {
  id               String    @id @default(uuid())
  guestBillId      String
  guestBill        GuestBill @relation(fields: [guestBillId], references: [id], onDelete: Restrict)
  amount           Float
  paymentMethod    String    // CASH, UPI, CARD, BANK_TRANSFER, OTHER
  paymentReference String?
  notes            String?
  recordedBy       String?   // Manager/Staff display name
  recordedById     String?   // Staff ID
  createdAt        DateTime  @default(now())

  @@index([guestBillId])
}

model AcademicYear {
  id           String               @id @default(uuid())
  code         String               @unique // e.g. "2026-2027"
  name         String               // e.g. "Academic Year 2026-2027"
  startDate    DateTime
  endDate      DateTime
  isCurrent    Boolean              @default(false)
  status       String               @default("ACTIVE") // ACTIVE, UPCOMING, PAST
  createdBy    String?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  structures   FeeStructure[]
  feeItems     FeeItem[]
  payments     FeePayment[]
  receipts     FeeReceipt[]
  scholarships StudentScholarship[]
  detentions   Detention[]

  @@index([status])
  @@index([isCurrent])
}

model FeeStructure {
  id             String        @id @default(uuid())
  academicYearId String
  academicYear   AcademicYear  @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  module         String        // HOSTEL, COLLEGE
  category       String        @default("REGULAR") // REGULAR, MANAGEMENT, CONVENOR, INTERNATIONAL, GENERAL
  feeKind        String        // College: ADMISSION, SPECIAL, TUITION, PENDING_DUES_REJOIN; Hostel: MESS_FEE, ROOM_RENT, AMENITIES, MAINTENANCE, CAUTION_DEPOSIT
  name           String
  amount         Decimal       @db.Decimal(12, 2)
  applicability  String?       // JSON: { "yearOfStudy": "All", "block": "All", "category": "All" }
  status         String        @default("ACTIVE") // ACTIVE, INACTIVE
  effectiveFrom  DateTime?
  effectiveTo    DateTime?
  createdBy      String?
  updatedBy      String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  feeItems       FeeItem[]

  @@index([academicYearId])
  @@index([module])
  @@index([feeKind])
  @@index([status])
}

model BankAccount {
  id                String       @id @default(uuid())
  name              String
  accountIdentifier String       @unique // e.g. "TUITION-001", "HOSTEL-001"
  bankName          String
  accountNumber     String
  ifsc              String
  kind              String       // DEPOSIT, MESS, TUITION, SPECIAL, HOSTEL, GENERAL
  module            String       @default("BOTH") // HOSTEL, COLLEGE, BOTH
  displayLabel      String
  status            String       @default("ACTIVE") // ACTIVE, INACTIVE
  createdBy         String?
  updatedBy         String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  payments          FeePayment[]

  @@index([status])
  @@index([accountIdentifier])
}

model ScholarshipType {
  id           String               @id @default(uuid())
  code         String               @unique // e.g. "JVD", "MERIT"
  name         String
  provider     String               @default("GOVERNMENT") // GOVERNMENT, INSTITUTION, PRIVATE
  maxAmount    Decimal?             @db.Decimal(12, 2)
  description  String?
  status       String               @default("ACTIVE") // ACTIVE, INACTIVE
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  scholarships StudentScholarship[]

  @@index([status])
}

model StudentScholarship {
  id                String          @id @default(uuid())
  studentId         String
  student           Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  scholarshipTypeId String
  scholarshipType   ScholarshipType @relation(fields: [scholarshipTypeId], references: [id], onDelete: Restrict)
  academicYearId    String
  academicYear      AcademicYear    @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  sanctionedAmount  Decimal         @db.Decimal(12, 2)
  appliedAmount     Decimal         @default(0.00) @db.Decimal(12, 2)
  remainingAmount   Decimal         @db.Decimal(12, 2)
  referenceNumber   String?
  remarks           String?
  status            String          @default("ASSIGNED") // ASSIGNED, APPROVED, APPLIED, REJECTED, CLOSED
  approvedBy        String?
  approvedAt        DateTime?
  appliedAt         DateTime?
  createdBy         String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([studentId])
  @@index([scholarshipTypeId])
  @@index([academicYearId])
  @@index([status])
}

model Detention {
  id                  String       @id @default(uuid())
  studentId           String
  student             Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  academicYearId      String
  academicYear        AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  currentYearOfStudy  String       // e.g. "3rd Year"
  detainedYearOfStudy String       // e.g. "3rd Year" or "2nd Year"
  reason              String
  status              String       @default("ACTIVE") // ACTIVE, REVOKED, COMPLETED
  detainedBy          String?
  detainedAt          DateTime     @default(now())
  revokedBy           String?
  revokedAt           DateTime?
  remarks             String?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  @@index([studentId])
  @@index([academicYearId])
  @@index([status])
}

model InstitutionSettings {
  id                 String   @id @default("GLOBAL")
  institutionMode    String   @default("BOTH") // HOSTEL_ONLY, COLLEGE_ONLY, BOTH
  institutionName    String   @default("Harsha Institution of Technology & Sciences")
  institutionCode    String   @default("HITS-01")
  enableScholarships Boolean  @default(true)
  enableDetentions   Boolean  @default(true)
  enableBulkUploads  Boolean  @default(true)
  updatedBy          String?
  updatedAt          DateTime @updatedAt
}

model FeeItem {
  id               String              @id @default(uuid())
  studentId        String
  student          Student             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  academicYearId   String
  academicYear     AcademicYear        @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  feeStructureId   String?
  feeStructure     FeeStructure?       @relation(fields: [feeStructureId], references: [id], onDelete: SetNull)
  feeType          String              // e.g. "Tuition Fee", "Mess Fee", "Special Fee"
  module           String              // HOSTEL, COLLEGE
  totalFee         Decimal             @db.Decimal(12, 2)
  paidAmount       Decimal             @default(0.00) @db.Decimal(12, 2)
  concessionAmount Decimal             @default(0.00) @db.Decimal(12, 2)
  dueAmount        Decimal             @db.Decimal(12, 2)
  excessPaid       Decimal             @default(0.00) @db.Decimal(12, 2)
  refundedAmount   Decimal             @default(0.00) @db.Decimal(12, 2)
  status           String              @default("UNPAID") // UNPAID, PARTIAL, PAID, OVERPAID
  isExtraFee       Boolean             @default(false)
  extraFeeDetails  String?             // JSON calculation inputs
  createdBy        String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  allocations      PaymentAllocation[]
  refunds          FeeRefund[]

  @@index([studentId])
  @@index([academicYearId])
  @@index([module])
  @@index([status])
  @@index([feeType])
}

model FeePayment {
  id                   String              @id @default(uuid())
  studentId            String
  student              Student             @relation(fields: [studentId], references: [id], onDelete: Restrict)
  academicYearId       String
  academicYear         AcademicYear        @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  bankAccountId        String
  bankAccount          BankAccount         @relation(fields: [bankAccountId], references: [id], onDelete: Restrict)
  amount               Decimal             @db.Decimal(12, 2)
  paymentMethod        String              // UPI, CHEQUE, SBI_COLLECT
  transactionReference String              // Unique reference per payment
  methodDetails        String?             // JSON details: upiApp, chequeNumber, bankName, receivedBy, verifiedBy
  status               String              @default("COMPLETED") // COMPLETED, VOID, REFUNDED
  receiptNumber        String              @unique
  recordedBy           String
  recordedById         String
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  allocations          PaymentAllocation[]
  receipt              FeeReceipt?
  refunds              FeeRefund[]

  @@index([studentId])
  @@index([academicYearId])
  @@index([bankAccountId])
  @@index([paymentMethod])
  @@index([transactionReference])
  @@index([status])
  @@index([createdAt])
}

model PaymentAllocation {
  id        String     @id @default(uuid())
  paymentId String
  payment   FeePayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  feeItemId String
  feeItem   FeeItem    @relation(fields: [feeItemId], references: [id], onDelete: Restrict)
  amount    Decimal    @db.Decimal(12, 2)
  createdAt DateTime   @default(now())

  @@index([paymentId])
  @@index([feeItemId])
}

model FeeReceipt {
  id             String       @id @default(uuid())
  receiptNumber  String       @unique
  paymentId      String       @unique
  payment        FeePayment   @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  studentId      String
  student        Student      @relation(fields: [studentId], references: [id], onDelete: Restrict)
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  totalAmount    Decimal      @db.Decimal(12, 2)
  receiptData    String       // JSON snapshot of receipt details
  createdAt      DateTime     @default(now())

  @@index([receiptNumber])
  @@index([studentId])
  @@index([academicYearId])
}

model FeeRefund {
  id            String      @id @default(uuid())
  feeItemId     String
  feeItem       FeeItem     @relation(fields: [feeItemId], references: [id], onDelete: Restrict)
  paymentId     String?
  payment       FeePayment? @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  studentId     String
  student       Student     @relation(fields: [studentId], references: [id], onDelete: Restrict)
  amount        Decimal     @db.Decimal(12, 2)
  reason        String
  status        String      @default("COMPLETED") // REQUESTED, APPROVED, COMPLETED, REJECTED
  processedBy   String
  processedById String
  createdAt     DateTime    @default(now())

  @@index([feeItemId])
  @@index([paymentId])
  @@index([studentId])
  @@index([status])
}

model FeeImportBatch {
  id          String   @id @default(uuid())
  batchType   String   // DUES_IMPORT, FEE_ADJUSTMENT, CREATE_FEE_ITEMS, REMOVE_FEE
  fileName    String
  totalRows   Int
  successRows Int
  failedRows  Int
  status      String   // COMPLETED, FAILED, PARTIAL
  errorReport String?  // JSON serialized errors
  uploadedBy  String
  createdAt   DateTime @default(now())

  @@index([batchType])
  @@index([createdAt])
}

model BiometricDevice {
  id                  String    @id @default(uuid())
  deviceIdentifier    String    @unique // e.g. "DEV-GATE-01", "DEV-TURNSTILE-02"
  name                String    // e.g. "Main Gate Biometric Reader #1"
  deviceType          String    // BIOMETRIC, GATE_READER, RFID, TURNSTILE, OTHER
  location            String    // e.g. "Main Hostel Gate", "Mess Entrance", "Block A Entry"
  description         String?
  status              String    @default("OFFLINE") // ONLINE, OFFLINE, MAINTENANCE, DISABLED
  isEnabled           Boolean   @default(true)
  apiKeyHash          String?   // SHA-256 hash of device secret; NEVER store plaintext
  keyLastRotatedAt    DateTime?
  lastSeenAt          DateTime?
  ipAddress           String?
  macAddress          String?
  firmwareVersion     String?
  maintenanceNotes    String?
  lastMaintenanceDate DateTime?
  configMetadata      String?   // JSON string for device configs
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([deviceIdentifier])
  @@index([deviceType])
  @@index([status])
  @@index([isEnabled])
  @@index([lastSeenAt])
  @@index([location])
}


